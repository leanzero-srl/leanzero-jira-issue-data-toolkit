# Environment Variables for Jira Field Data Merger
# Copy this file to .env and fill in your credentials

# Jira Instance Configuration (for same-instance merges)
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=admin@company.com
JIRA_TOKEN=your-api-token-here

# OR for cross-instance migrations:
# JIRA_SOURCE_URL=https://source-company.atlassian.net
# JIRA_TARGET_URL=https://target-company.atlassian.net
# JIRA_SOURCE_EMAIL=admin@source.com
# JIRA_TARGET_EMAIL=admin@target.com
# JIRA_SOURCE_TOKEN=source-api-token-here
# JIRA_TARGET_TOKEN=target-api-token-here

# Common field migration settings (these can be overridden via CLI)
JIRA_SOURCE_FIELD=customfield_10001
JIRA_TARGET_FIELD=customfield_10002

# Optional: Default project for testing migrations
# JIRA_PROJECT_KEY=DEMO

# Security Notes:
# - Never commit this file with actual credentials to version control
# - Use .env.local for development overrides (add to .gitignore)
# - Rotate tokens regularly and limit their permissions
# - Tokens should have only "Edit Issues" permission for security

# Example usage with environment variables:
# node merge_field_data.js \
#   --url "$JIRA_URL" \
#   --email "$JIRA_EMAIL" \
#   --token "$JIRA_TOKEN" \
#   --source-field "$JIRA_SOURCE_FIELD" \
#   --target-field "$JIRA_TARGET_FIELD"
