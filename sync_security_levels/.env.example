# =============================================================================
# Sync Security Levels: Datacenter -> Cloud
# =============================================================================

# Jira Datacenter (Basic Auth with username:password)
DC_BASE_URL=https://jira-dc.example.com
DC_USERNAME=admin
DC_PASSWORD=secret

# Jira Cloud (Basic Auth with pre-encoded base64(email:api_token))
CLOUD_BASE_URL=https://yoursite.atlassian.net
CLOUD_API_TOKEN=base64_encoded_email_colon_token
