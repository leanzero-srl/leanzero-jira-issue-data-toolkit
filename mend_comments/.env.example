# Jira Datacenter (use either DC_PAT, OR DC_USERNAME+DC_PASSWORD)
DC_BASE_URL=https://jira.example.com
# DC_PAT=your_personal_access_token
DC_USERNAME=
DC_PASSWORD=

# Jira Cloud
CLOUD_BASE_URL=https://example.atlassian.net
# Base64-encoded "email:api_token"  (echo -n "email:token" | base64)
CLOUD_API_TOKEN=

# Comma-separated list of Cloud accountIds whose CREATED issues we mend (default: the 2 JCMA migration accounts)
MEND_CREATOR_ACCOUNT_IDS=712020:00000000-0000-0000-0000-000000000000,712020:00000000-0000-0000-0000-000000000000
