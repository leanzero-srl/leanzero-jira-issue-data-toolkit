# =============================================================================
# sync_custom_fields: Jira Datacenter -> Cloud custom-field value sync
# =============================================================================

# Jira Datacenter (source of truth). Either a PAT (preferred) OR username+password.
DC_BASE_URL=https://jira.example.com
# DC_PAT=your-personal-access-token
DC_USERNAME=your-dc-username
DC_PASSWORD=your-dc-password

# Jira Cloud (target).
CLOUD_BASE_URL=https://example.atlassian.net
# Base64-encoded "email:api_token"  (echo -n "you@example.com:ATATT..." | base64)
CLOUD_API_TOKEN=base64-of-email-colon-apitoken
