# Jira Cloud instance
CLOUD_BASE_URL=https://your-site.atlassian.net

# Base64("email:apiToken")  -- echo -n "you@example.com:ATATT..." | base64
CLOUD_API_TOKEN=base64-of-email-colon-apitoken

# Tempo OAuth 2.0 bearer token (Tempo -> Settings -> API integration).
# Needs "Override Mode" enabled to write into closed periods.
TEMPO_API_TOKEN=your-tempo-token
